         role: 'user',
@@ -54,5 +53,5 @@ export async function generatePromptContent(
     ],
   })
 
-  return { ...extractToolInput<Generated>(message, 'save_prompt'), model }
+  return { ...extractJson<Generated>(message), model }
 }
