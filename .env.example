# Supabase（Project Settings → API）
SUPABASE_URL=
SUPABASE_KEY=            # anon / publishable key
SUPABASE_SERVICE_KEY=    # service_role key（サーバー専用。絶対に公開しない）

# Claude API
NUXT_ANTHROPIC_API_KEY=
NUXT_ANTHROPIC_MODEL=claude-sonnet-5-5

# cron 用の合言葉（Vercel では CRON_SECRET という名前で設定すると自動で付与される）
CRON_SECRET=
