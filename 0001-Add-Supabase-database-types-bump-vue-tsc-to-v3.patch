+// Supabase のプロジェクトができたら、次のコマンドで生成した型に置き換える:
+//   npx supabase gen types typescript --project-id <id> > app/types/database.types.ts
+
+export type Json =
+  | string
+  | number
+  | boolean
+  | null
+  | { [key: string]: Json | undefined }
+  | Json[]
